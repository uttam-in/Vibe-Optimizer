# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vibe_optimizer
# For development: sqlite:///./vibe_optimizer.db

# API Keys
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Email
SENDGRID_API_KEY=your_sendgrid_api_key
REPORT_EMAIL_FROM=reports@vibeoptimizer.com
REPORT_EMAIL_TO=team@company.com

# NLP Models
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501

# Scheduling
INGESTION_INTERVAL_MINUTES=30
REPORT_SCHEDULE_CRON=0 9 * * 1
